   795	                }
   796	        } else if (dtype == q27::DType::Q4_G64) {
   797	            data.resize((size_t)rows * cols / 2);
   798	            for (uint32_t r = 0; r < rows; r++)
   799	                for (uint32_t c = 0; c < cols; c++) {
   800	                    int q = ((int)w[(size_t)r * cols + c] % 8 + 8) % 16 - 8;
   801	                    w[(size_t)r * cols + c] = (int8_t)q;
   802	                    uint8_t nibble = (uint8_t)(q + 8);
   803	                    size_t i = (size_t)r * cols / 2 + c / 2;
   804	                    if (c & 1) data[i] = (uint8_t)((data[i] & 15) | (nibble << 4));
   805	                    else data[i] = (uint8_t)((data[i] & 240) | nibble);
   806	                }
   807	        } else {
   808	            data.assign((const uint8_t*)w.data(), (const uint8_t*)w.data() + w.size());
   809	        }
   810	        const uint16_t scale_bits[4] = {0x3400, 0x3800, 0x3c00, 0x4000};
   811	        const float scale_f32[4] = {0.25f, 0.5f, 1.0f, 2.0f};
   812	        std::vector<uint16_t> scales(rows * groups);
   813	        for (size_t i = 0; i < scales.size(); i++) scales[i] = scale_bits[i % 4];
   814	        q27::Tensor tensor;
   815	        tensor.name = "wide";
   816	        tensor.dtype = dtype;
   817	        tensor.shape = {rows, cols};
   818	        tensor.data = data.data();
   819	        tensor.data_size = data.size();
   820	        tensor.scales = (const uint8_t*)scales.data();
