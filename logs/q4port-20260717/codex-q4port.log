   768	int test_quantized_wide(q27::MetalBackend& backend, q27::DType dtype) {
   769	    const uint32_t group = dtype == q27::DType::Q4_G64 ? 64 : 128;
   770	    // main chunk + tail, then a production column count
   771	    const uint32_t widths[2] = {1024 + group, 5120};
   772	    for (uint32_t cols : widths) {
   773	        constexpr uint32_t rows = 5;
   774	        const uint32_t groups = cols / group;
   775	        std::vector<int8_t> w(rows * cols);
   776	        for (uint32_t r = 0; r < rows; r++)
   777	            for (uint32_t c = 0; c < cols; c++)
   778	                w[(size_t)r * cols + c] = (int8_t)((int)((r * 13 + c * 7) % 29) - 14);
   779	        std::vector<uint8_t> data;
   780	        if (dtype == q27::DType::T2_G128) {
   781	            data.assign((size_t)rows * cols / 4, 0);
   782	            for (uint32_t r = 0; r < rows; r++)
   783	                for (uint32_t c = 0; c < cols; c++) {
   784	                    const int q = (int)((r * 13 + c * 7) % 3) - 1;
