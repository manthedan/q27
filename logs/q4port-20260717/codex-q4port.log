  2517	// Q4 chunk GEMM on the half-staging pattern of q27_matmul_t2_mm_h (variant
  2518	// G-prime, docs/plans/2026-07-15-gemm-half-staging.md follow-up; port pre-
  2519	// registered in 2026-07-17-t2-prefill-throughput.md): half tiles, raw Q4
  2520	// codes (-8..+7) and raw int8 activations both integer-exact in half, FLOAT
  2521	// accumulators (mixed-precision MMA). Products are bounded by 8*128 = 1024 <
  2522	// 2048, so every product is exact in half regardless of where the MMA
  2523	// rounds, and float accumulation keeps sums exact to 2^24 — stronger than
  2524	// the float-staged q27_matmul_q4_mm it replaces, whose activation side
  2525	// rounded once per value at staging. The Q4 scale group is 64 columns, so
  2526	// each staged 64-K tile coincides with exactly one weight-scale group
  2527	// (index c0/64, row stride cols/64); activation scales fold per 32-K
  2528	// sub-slab at the flush exactly as in the T2 kernel.
  2529	kernel void q27_matmul_q4_mm_h(
  2530	        device const uchar *weights [[buffer(0)]], device const half *weight_scales [[buffer(1)]],
  2531	        device const char *x [[buffer(2)]], device const float *x_scales [[buffer(3)]],
  2532	        device float *out [[buffer(4)]], constant MatmulArgs &args [[buffer(5)]],
  2533	        uint2 group [[threadgroup_position_in_grid]],
  2534	        uint tid [[thread_index_in_threadgroup]],
  2535	        ushort lane [[thread_index_in_simdgroup]],
  2536	        ushort sg [[simdgroup_index_in_threadgroup]]) {
  2537	    threadgroup half Wt[32 * 64];
  2538	    threadgroup half Xt[64 * 16];
  2539	    threadgroup float Sc[4 * 256];
  2540	    const uint row0 = group.x * 32;
  2541	    const uint tok0 = group.y * 16;   // 16-token tile (wide-chunk grid)
  2542	    if (row0 >= args.rows) return;
  2543	    const uint rlast = args.rows - 1;
  2544	    const uint wrow = tid / 4, wcb = (tid % 4) * 16;
  2545	    device const uchar *wsrc = weights + (ulong)min(row0 + wrow, rlast) * (args.cols / 2);
  2546	    const uint xloc = tid % 16, xcb = (tid / 16) * 8;   // Xt column is tile-local
  2547	    const uint xtok = tok0 + xloc;                       // device rows are global
  2548	    device const char *xsrc = x + (ulong)min(xtok, args.x_rows - 1) * args.cols;
  2549	    const uint rowA = row0 + sg * 8 + lane / 8, rowB = rowA + 4;
  2550	    const ulong wsrowA = (ulong)min(rowA, rlast) * (args.cols / 64);
  2551	    const ulong wsrowB = (ulong)min(rowB, rlast) * (args.cols / 64);
  2552	    simdgroup_float8x8 acc0 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  2553	    simdgroup_float8x8 acc1 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  2554	    simdgroup_float8x8 acc2 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  2555	    simdgroup_float8x8 acc3 = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  2556	    float4 racc = 0.0f;
  2557	    threadgroup float *sc = Sc + sg * 256;
  2558	    const uint tokA = tok0 + lane % 8, tokB = tok0 + 8 + lane % 8;
  2559	    for (uint c0 = 0; c0 < args.cols; c0 += 64) {
  2560	        {
  2561	            // 16 columns = 8 bytes per thread: one byte-LUT gather per
  2562	            // nibble pair, low nibble first (matches the float kernel's
  2563	            // LSB-first order). wcb is a multiple of 16 -> half2-aligned.
  2564	            const uint2 wp = *(device const uint2 *)(wsrc + (c0 + wcb) / 2);
  2565	            threadgroup half2 *dst = (threadgroup half2 *)(Wt + wrow * 64 + wcb);
  2566	            dst[0] = q27_q4_half2_lut[wp.x         & 0xffu];
  2567	            dst[1] = q27_q4_half2_lut[(wp.x >>  8) & 0xffu];
  2568	            dst[2] = q27_q4_half2_lut[(wp.x >> 16) & 0xffu];
  2569	            dst[3] = q27_q4_half2_lut[wp.x >> 24         ];
  2570	            dst[4] = q27_q4_half2_lut[wp.y         & 0xffu];
  2571	            dst[5] = q27_q4_half2_lut[(wp.y >>  8) & 0xffu];
  2572	            dst[6] = q27_q4_half2_lut[(wp.y >> 16) & 0xffu];
  2573	            dst[7] = q27_q4_half2_lut[wp.y >> 24         ];
  2574	        }
  2575	        {
  2576	            const char4 xa = *(device const char4 *)(xsrc + c0 + xcb);
  2577	            const char4 xb = *(device const char4 *)(xsrc + c0 + xcb + 4);
  2578	            threadgroup half *dst = Xt + xcb * 16 + xloc;
  2579	            // Raw int8 values: exact in half. The per-token 32-group scale
  2580	            // folds at the flush below; invalid token slots stage clamped
  2581	            // real values whose outputs are never stored.
