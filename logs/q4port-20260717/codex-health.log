    33	        try: d=json.loads(line)
    34	        except Exception: bad+=1; continue
    35	        k=d.get("kind"); kinds.append(k)
    36	        if k=="boot": boots+=1
    37	        if k=="request": apis.add(d.get("api"))
    38	        if k=="outcome": outcomes.add(d.get("api"))
    39	        if k=="error": errors.append((d.get("status"),d.get("type")))
    40	        if k=="prefix": prefixes+=1
    41	        t=d.get("tms",-1)
    42	        if k=="boot": prev_tms=-1   # append-across-restarts: tms resets per process
    43	        if t<prev_tms: monotonic=False
    44	        prev_tms=t
    45	def report(ok,msg): print(("PASS" if ok else "FAIL")+": "+msg); sys.exit(0 if False else 0) or (not ok and sys.stdout.write("")) or ok
