   134	// Tools preamble, verbatim structure from the chat template. `tools` entries
   135	// must already be in {"type":"function","function":{...}} shape.
   136	// Claude Code (<= 2.1.1xx era) prefixes its system prompt with
   137	//   x-anthropic-billing-header: cc_version=...; cc_entrypoint=cli; cch=a5145;You are...
   138	// The cch stamp is an integrity hint that CHANGES ON EVERY REQUEST, so the
   139	// first bytes of the prompt mutate per turn -- which voids the P8 stable-prefix
   140	// snapshot and P9 checkpoint routing for the entire conversation (measured
   141	// under Claude Code: 126K-token full re-prefill, ~72s, on every turn). Pin the
   142	// stamp to 'f's, mirroring llama.cpp's normalize_anthropic_billing_header
   143	// (ggml-org/llama.cpp#21793), so both engines canonicalize to the same bytes.
   144	// Only a header at the very start of the system text is touched, and the stamp
   145	// is only looked for inside the short header segment.
   146	inline void normalize_cc_billing_header(std::string& sys) {
   147	    static const char* PFX = "x-anthropic-billing-header:";
   148	    if (sys.rfind(PFX, 0) != 0) return;
   149	    size_t cch = sys.find("cch=", 27);
   150	    if (cch == std::string::npos || cch > 160) return;  // header segment only
   151	    size_t v = cch + 4, end = sys.find(';', v);
   152	    if (end == std::string::npos || end == v || end - v > 16) return;
   153	    for (size_t i = v; i < end; ++i) sys[i] = 'f';
