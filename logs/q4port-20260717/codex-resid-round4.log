    67	// R1b: FIFO ticket lock time-slicing the GPU across concurrent generations.
    68	// Replaces the server's whole-generation mutex. The holder calls
    69	// maybe_yield() at round/chunk boundaries: if anyone is queued it releases
    70	// and re-acquires -- the fresh ticket lands at the TAIL, so contended
    71	// requests round-robin at round granularity instead of head-of-line
    72	// blocking for a whole generation. Solo path: one relaxed atomic load per
    73	// call, no syscalls. contended() can miss a waiter arriving in the same
    74	// instant (nwait is read unlocked); it is caught one round (~27ms) later.
    75	struct GpuGate {
    76	    void acquire() {
    77	        std::unique_lock<std::mutex> lk(m);
    78	        uint64_t t = next++;
    79	        if (t != serving) {
    80	            nwait.fetch_add(1, std::memory_order_relaxed);
    81	            cv.wait(lk, [&] { return serving == t; });
    82	            nwait.fetch_sub(1, std::memory_order_relaxed);
    83	        }
    84	    }
    85	    void release() {
    86	        { std::lock_guard<std::mutex> lk(m); serving++; }
    87	        cv.notify_all();
    88	    }
    89	    int contended() const { return nwait.load(std::memory_order_relaxed); }
    90	    // RAII whole-hold (the R1-equivalent region): exception-safe release,
    91	    // same role the old lock_guard played at the server call sites.
    92	    // Exemption to the drained-handover invariant: microsecond-scale async
    93	    // copies queued AFTER the last yield point (tool-constraint clears,
    94	    // n_max==0 tails) may still be in flight at ~Lease. All target
    95	    // per-engine buffers and are stream-ordered ahead of that engine's next
    96	    // work, so no cross-engine hazard exists; the GPU is "idle" at release
    97	    // only up to those copies.
    98	    struct Lease {
    99	        explicit Lease(GpuGate& gg) : g(gg) { g.acquire(); }
   100	        ~Lease() { g.release(); }
   101	        Lease(const Lease&) = delete;
   102	        Lease& operator=(const Lease&) = delete;
   103	        GpuGate& g;
   104	    };
   105	    // Yield the GPU to queued waiters; true if a handover actually happened.
   106	    // The new ticket is taken in the SAME critical section as the handover:
   107	    // release();acquire() would let a descheduled yielder lose its queue
   108	    // position to the next yielder (caught by the C1 self-test), breaking
   109	    // strict rotation.
   110	    bool maybe_yield() {
   111	        if (!contended()) return false;
   112	        std::unique_lock<std::mutex> lk(m);
   113	        if (next - serving <= 1) return false; // raced: waiter already gone
   114	        uint64_t t = next++;
   115	        serving++;
   116	        cv.notify_all();
   117	        nwait.fetch_add(1, std::memory_order_relaxed);
   118	        cv.wait(lk, [&] { return serving == t; });
   119	        nwait.fetch_sub(1, std::memory_order_relaxed);
   120	        return true;
   121	    }
   122	private:
   123	    std::mutex m;
   124	    std::condition_variable cv;
   125	    uint64_t next = 0, serving = 0;
   126	    std::atomic<int> nwait{0};
   127	};
