    23	// Incremental UTF-8 boundary gate for streaming token pieces. BPE token
    24	// boundaries can split a multi-byte character (em dash E2 80 94 is a Qwopus
    25	// favorite), the raw piece is then invalid UTF-8, and nlohmann json::dump
    26	// throws type_error.316 on it -- which took q27-server down mid-generation
    27	// under Claude Code (R0, 2026-07-04). feed() returns the longest valid
    28	// prefix, holding back an incomplete trailing sequence until its
    29	// continuation bytes arrive; flush() ends the stream, turning a dangling
    30	// partial into U+FFFD. Invalid leads/continuations pass through -- the
    31	// dump-time replace error handler is the backstop for those.
    32	struct Utf8Gate {
    33	    std::string pend;
    34	    static int seq_len(unsigned char b) {
    35	        if (b < 0x80) return 1;
    36	        if ((b & 0xE0) == 0xC0) return 2;
    37	        if ((b & 0xF0) == 0xE0) return 3;
    38	        if ((b & 0xF8) == 0xF0) return 4;
    39	        return -1; // continuation or invalid lead byte
    40	    }
    41	    std::string feed(const std::string& piece) {
    42	        pend += piece;
    43	        size_t n = pend.size(), i = n;
    44	        int back = 0;
    45	        while (i > 0 && back < 4) {
    46	            unsigned char b = (unsigned char)pend[i - 1];
    47	            if ((b & 0xC0) != 0x80) { i--; break; }
    48	            i--;
    49	            back++;
    50	        }
    51	        size_t cut = n;
    52	        if (i < n) {
    53	            int L = seq_len((unsigned char)pend[i]);
    54	            if (L > 0 && i + (size_t)L > n) cut = i; // incomplete tail: hold back
    55	        }
    56	        std::string out = pend.substr(0, cut);
    57	        pend.erase(0, cut);
    58	        return out;
    59	    }
    60	    std::string flush() {
    61	        std::string out = pend.empty() ? std::string() : std::string("\xEF\xBF\xBD");
    62	        pend.clear();
    63	        return out;
    64	    }
    65	};
