   749	            // mode 8: alias-named call object ({"function": "Read", ...});
   750	            // registered-name validation inside keeps prose JSON out
   751	            std::string an;
   752	            json aa;
   753	            if (resolve_aliased_call(*tools, j8, an, aa)) {
   754	                ToolCall tc; tc.ok = true; tc.name = std::move(an); tc.arguments = std::move(aa);
   755	                if (first == std::string::npos) first = i;
   756	                out.push_back(std::move(tc));
   757	                m8 = true;
   758	                i = text.find('{', end + 1);
   759	                continue;
   760	            }
   761	        }
   762	        i = text.find('{', i + 1);
   763	    }
   764	    // Fallback: name-dropped mode-6 BATCH (the main scan can't segment it). Only when the
   765	    // standard scan found nothing, so normal calls are never double-counted.
   766	    if (out.empty() && tools && text.find("{\"name\":") != std::string::npos) {
   767	        scan_namedropped(text, tools, out, &first);
   768	        if (!out.empty()) m6 = true;
   769	    }
   770	    if (prefix) {
   771	        std::string p = first == std::string::npos ? "" : strip_ws2(text.substr(0, first));
   772	        // drop a dangling {"tool_call": opener fragment (mode-4 wrapper junk)
   773	        if (p.size() >= 13 && p.compare(p.size() - 13, 13, "{\"tool_call\":") == 0)
   774	            p = strip_ws2(p.substr(0, p.size() - 13));
   775	        // drop a dangling {"name": opener fragment (mode-6/8 hybrid prefix line)
   776	        if (p.size() >= 8 && p.compare(p.size() - 8, 8, "{\"name\":") == 0)
   777	            p = strip_ws2(p.substr(0, p.size() - 8));
   778	        *prefix = p;
   779	    }
   780	    // Drift catalog (exit gate, docs/sampling-exit-gate.md): tag which tool-format
   781	    // drift mode(s) the fallback chain rescued, or flag an intended call it could
   782	    // NOT recover. Log-only; the parse result is unchanged.
   783	    if (!out.empty()) {
   784	        char modes[8]; int mi = 0;
   785	        modes[mi++] = '1';               // baseline: dropped-<tool_call>-wrapper recovery
   786	        if (m2) modes[mi++] = '2';
   787	        if (m3) modes[mi++] = '3';
   788	        if (m4) modes[mi++] = '4';
   789	        if (m5) modes[mi++] = '5';
   790	        if (m6) modes[mi++] = '6';
   791	        if (m8) modes[mi++] = '8';
   792	        modes[mi] = 0;
   793	        fprintf(stderr, "[drift] recovered=%zu modes=%s\n", out.size(), modes);
   794	    } else if (text_in.find("{\"name\"") != std::string::npos ||
   795	               text_in.find("{\"tool_call\"") != std::string::npos) {
   796	        // ntools distinguishes plumbing (-1/0) from a schema/inference miss (>0 =
   797	        // mode-6 args didn't confidently match any tool). Longer window so the call
   798	        // (not just a long preamble) is visible for post-hoc arg-shape diagnosis.
   799	        fprintf(stderr, "[drift] UN-RESCUED (ntools=%d) intended tool call: %.400s\n",
   800	                tools ? (int)tools->size() : -1, text_in.c_str());
   801	    }
   802	    return out;
   803	}
   804	
   805	// Single-call convenience wrapper (first recovered call). suffix retained for
   806	// callers that trim trailing junk; multi-call callers use the vector form.
   807	inline ToolCall parse_bare_tool_call(const std::string& text_in, std::string* prefix,
   808	                                     std::string* suffix, const json* tools = nullptr) {
   809	    auto v = parse_bare_tool_calls(text_in, prefix, tools);
   810	    if (v.empty()) return ToolCall{};
   811	    if (suffix) *suffix = "";
   812	    return v.front();
   813	}
