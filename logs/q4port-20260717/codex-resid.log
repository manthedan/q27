    94	
    95	// Invalid-UTF-8-tolerant serialize: json::dump's strict default throws
    96	// type_error.316, and an uncaught throw inside a streaming provider is
    97	// std::terminate. The Utf8Gate keeps split characters intact; this is the
    98	// backstop for everything else. Same as server.cu's file-scope jdump.
    99	inline std::string sse_dump(const nlohmann::json& j) {
   100	    return j.dump(-1, ' ', false, nlohmann::json::error_handler_t::replace);
   101	}
   102	
   103	// OpenAI framing: "data: {json}\n\n".
   104	inline std::string sse_data(const nlohmann::json& j) {
   105	    return "data: " + sse_dump(j) + "\n\n";
   106	}
   107	
   108	// Anthropic / Responses framing: "event: NAME\ndata: {json}\n\n".
   109	inline std::string sse_event(const std::string& name, const nlohmann::json& j) {
   110	    return "event: " + name + "\ndata: " + sse_dump(j) + "\n\n";
   111	}
   112	
   113	// OpenAI stream terminator.
   114	inline std::string sse_done() { return "data: [DONE]\n\n"; }
   115	
   116	// One OpenAI streaming delta chunk. `chat` selects chat.completion.chunk
   117	// (delta.content) vs text_completion (text); finish_reason is null in piece
   118	// chunks, exactly as the CUDA server emits them.
   119	inline nlohmann::json openai_stream_chunk(bool chat, const std::string& id, const char* object,
   120	                                          long created, const std::string& model,
   121	                                          const std::string& piece) {
   122	    using nlohmann::json;
   123	    json choice = chat
   124	        ? json{{"index", 0}, {"delta", {{"content", piece}}}, {"finish_reason", nullptr}}
   125	        : json{{"index", 0}, {"text", piece}, {"finish_reason", nullptr}};
   126	    return json{{"id", id}, {"object", object}, {"created", created},
   127	                {"model", model}, {"choices", json::array({choice})}};
   128	}
   129	
   130	// Terminal OpenAI streaming chunk: a real finish_reason ("stop"/"length")
   131	// before [DONE], per the OpenAI streaming spec — clients otherwise never
   132	// learn whether generation hit EOS or the token cap. Mirrors the CUDA
   133	// server's shape (upstream security-review fix #7): empty delta object for
   134	// chat, empty text for completions.
   135	inline nlohmann::json openai_stream_final_chunk(bool chat, const std::string& id,
   136	                                                const char* object, long created,
   137	                                                const std::string& model,
   138	                                                const char* finish_reason) {
   139	    using nlohmann::json;
   140	    json choice = chat
   141	        ? json{{"index", 0}, {"delta", json::object()}, {"finish_reason", finish_reason}}
   142	        : json{{"index", 0}, {"text", ""}, {"finish_reason", finish_reason}};
   143	    return json{{"id", id}, {"object", object}, {"created", created},
   144	                {"model", model}, {"choices", json::array({choice})}};
   145	}
