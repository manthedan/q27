    20	namespace q27 {
    21	
    22	// Stop-sequence holdback for streaming text. Implements the OpenAI `stop` /
    23	// Anthropic `stop_sequences` contract for an incremental byte stream: text up
    24	// to (but not including) the first stop occurrence is emitted, the stop
    25	// sequence itself and everything after it is suppressed, and generation stops.
    26	// Because pieces arrive incrementally, a trailing substring of the emitted
    27	// text that could still grow into a stop sequence is held back until it is
    28	// resolved (completed -> stop, or diverged -> released). This is the standard
    29	// partial-prefix holdback; without it a stop sequence split across two tokens
    30	// would leak its first half to the client before the match fires.
    31	struct StopBuffer {
    32	    std::vector<std::string> stops;
    33	    std::string pend;
    34	    int matched = -1; // index into `stops` once a full match fires, else -1
    35	
    36	    explicit StopBuffer(std::vector<std::string> seqs = {}) : stops(std::move(seqs)) {
    37	        // Drop empty stop strings: they would "match" at every position.
    38	        stops.erase(std::remove(stops.begin(), stops.end(), std::string()), stops.end());
    39	    }
    40	
    41	    bool active() const { return !stops.empty(); }
    42	
    43	    // Feed one decoded (already UTF-8-gated) piece. Returns text safe to emit
    44	    // now. Sets `stopped` true (and `matched`) when a stop sequence completed;
    45	    // when stopped, the returned text is the content strictly before the stop.
    46	    std::string feed(const std::string& piece, bool& stopped) {
    47	        stopped = false;
    48	        if (stops.empty()) return piece; // fast path: no stop sequences
    49	        pend += piece;
    50	        // 1. Earliest full match anywhere in the buffer ends the stream.
    51	        size_t best_pos = std::string::npos;
    52	        int best_idx = -1;
    53	        for (size_t s = 0; s < stops.size(); s++) {
    54	            size_t p = pend.find(stops[s]);
    55	            if (p != std::string::npos && (best_pos == std::string::npos || p < best_pos)) {
    56	                best_pos = p;
    57	                best_idx = (int)s;
    58	            }
    59	        }
    60	        if (best_pos != std::string::npos) {
    61	            stopped = true;
    62	            matched = best_idx;
    63	            std::string out = pend.substr(0, best_pos);
    64	            pend.clear();
    65	            return out;
    66	        }
    67	        // 2. No full match: hold back the longest suffix of `pend` that is a
    68	        // proper prefix of some stop sequence (it may complete next feed).
    69	        size_t hold = 0;
    70	        for (const std::string& s : stops) {
    71	            size_t kmax = std::min(pend.size(), s.size() - 1);
    72	            for (size_t k = kmax; k >= 1; k--) {
    73	                if (pend.compare(pend.size() - k, k, s, 0, k) == 0) {
    74	                    if (k > hold) hold = k;
    75	                    break;
    76	                }
    77	            }
    78	        }
    79	        size_t emit_len = pend.size() - hold;
    80	        std::string out = pend.substr(0, emit_len);
    81	        pend.erase(0, emit_len);
    82	        return out;
    83	    }
    84	
    85	    // End of stream without a stop match: held-back text is real output.
    86	    std::string flush() {
    87	        std::string out = pend;
    88	        pend.clear();
    89	        return out;
    90	    }
    91	};
