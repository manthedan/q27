     1	// Streaming splitter for Qwopus output markers: <think>...</think> reasoning
     2	// and <tool_call>...</tool_call> function calls, both emitted as plain-text
     3	// tokens. Feeds token-by-token decoded text and routes segments into THINK /
     4	// TEXT / TOOL channels, holding back any tail that could be a partial marker.
     5	// Markers do not nest; tool_calls can appear only outside think blocks in
     6	// well-formed output, but we tolerate them inside by scanning TEXT only.
     7	#pragma once
     8	#include <algorithm>
     9	#include <cstring>
    10	#include <string>
    11	#include <utility>
    12	#include <vector>
    13	
    14	namespace q27 {
    15	
    16	struct StreamSplitter {
    17	    enum Chan { TEXT, THINK, TOOL };
    18	    Chan chan = TEXT;
    19	    std::string hold;
    20	
    21	    static constexpr const char* T_OPEN = "<think>";
    22	    static constexpr const char* T_CLOSE = "</think>";
    23	    static constexpr const char* C_OPEN = "<tool_call>";
    24	    static constexpr const char* C_CLOSE = "</tool_call>";
    25	
    26	    std::vector<std::pair<Chan, std::string>> feed(const std::string& piece) {
    27	        hold += piece;
    28	        std::vector<std::pair<Chan, std::string>> out;
    29	        for (;;) {
    30	            if (chan == TEXT) {
    31	                // whichever of <think> / <tool_call> comes first
    32	                size_t pt = hold.find(T_OPEN), pc = hold.find(C_OPEN);
    33	                if (pt != std::string::npos && (pc == std::string::npos || pt < pc)) {
    34	                    if (pt > 0) out.push_back({TEXT, hold.substr(0, pt)});
    35	                    hold.erase(0, pt + strlen(T_OPEN));
    36	                    chan = THINK;
    37	                    continue;
    38	                }
    39	                if (pc != std::string::npos) {
    40	                    if (pc > 0) out.push_back({TEXT, hold.substr(0, pc)});
    41	                    hold.erase(0, pc + strlen(C_OPEN));
    42	                    chan = TOOL;
    43	                    continue;
    44	                }
    45	                // hold back the longest suffix that prefixes either opener
    46	                size_t keep = tail_keep(T_OPEN);
    47	                keep = std::max(keep, tail_keep(C_OPEN));
    48	                emit_head(out, keep);
    49	                break;
    50	            }
    51	            const char* closer = chan == THINK ? T_CLOSE : C_CLOSE;
    52	            size_t p = hold.find(closer);
    53	            if (p != std::string::npos) {
    54	                if (p > 0) out.push_back({chan, hold.substr(0, p)});
    55	                hold.erase(0, p + strlen(closer));
    56	                chan = TEXT;
    57	                continue;
    58	            }
    59	            emit_head(out, tail_keep(closer));
    60	            break;
    61	        }
    62	        return out;
    63	    }
    64	
    65	    std::vector<std::pair<Chan, std::string>> flush() {
    66	        std::vector<std::pair<Chan, std::string>> out;
    67	        if (!hold.empty()) { out.push_back({chan, hold}); hold.clear(); }
    68	        return out;
    69	    }
    70	
    71	  private:
    72	    size_t tail_keep(const char* marker) const {
    73	        size_t mlen = strlen(marker);
    74	        size_t maxk = std::min(hold.size(), mlen - 1);
    75	        for (size_t k = maxk; k > 0; k--)
    76	            if (hold.compare(hold.size() - k, k, marker, k) == 0) return k;
    77	        return 0;
    78	    }
    79	    void emit_head(std::vector<std::pair<Chan, std::string>>& out, size_t keep) {
    80	        if (hold.size() > keep) {
    81	            out.push_back({chan, hold.substr(0, hold.size() - keep)});
    82	            hold.erase(0, hold.size() - keep);
    83	        }
    84	    }
    85	};
    86	
    87	} // namespace q27

