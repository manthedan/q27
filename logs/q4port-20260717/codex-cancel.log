   194	// Disk snapshot store (prefix snapshots Phase 2, docs/plans/2026-07-16-
   195	// prefix-snapshots.md): token-prefix keyed — the server tokenizes every
   196	// prompt itself, so "the snapshot's stored token ids are a prefix of this
   197	// request's tokens" is exact and has no BPE-boundary hazard (recorded
   198	// design deviation from ds4's byte-SHA1, which exists for stateless
   199	// clients that retokenize). Files are named by the SHA1 of the token
   200	// bytes, so an identical prefix overwrites rather than duplicates. LRU by
   201	// mtime; hits touch the file. All file I/O runs OUTSIDE the GPU lease;
   202	// only save_state/load_state (which read/write GPU buffers) go under it.
   203	class DiskSnapshotStore {
   204	  public:
   205	    // tag = artifact/KV identity prefix baked into every filename, so one
   206	    // directory shared by different artifacts or fp16/turbo3 servers never
   207	    // cross-matches or overwrites incompatible snapshots (codex P2 on
   208	    // 607160e); the deep header identity check at load stays underneath.
   209	    void init(std::string dir, uint64_t max_bytes, std::string tag) {
   210	        dir_=std::move(dir); max_bytes_=max_bytes; tag_=std::move(tag);
   211	    }
   212	    bool enabled() const { return !dir_.empty(); }
   213	
   214	    // Longest stored token prefix of `prompt`. Full-length matches whose
   215	    // logits are stale (mid-prefill saves) are skipped: state would be
   216	    // exact but no pending token could be derived.
   217	    bool best_match(const std::vector<uint32_t>& prompt,std::string& path_out,uint32_t& len_out) {
   218	        if(!enabled()) return false;
   219	        std::lock_guard<std::mutex> lk(m_);
   220	        std::string best; uint32_t best_len=0;
   221	        std::error_code ec;
   222	        for(const auto& e:std::filesystem::directory_iterator(dir_,ec)) {
   223	            if(!e.is_regular_file() || e.path().extension()!=".q27snap") continue;
   224	            if(e.path().filename().string().rfind(tag_,0)!=0) continue;
   225	            q27::MetalEngine::SnapshotInfo info;
   226	            try { info=q27::MetalEngine::peek_snapshot(e.path().string()); }
   227	            catch(...) { continue; }   // corrupt/foreign file: never a hit
   228	            // Saves record exactly the encoded prefix; anything else is not
   229	            // resumable by token matching.
   230	            if(info.position!=info.tokens.size()) continue;
   231	            if(info.tokens.empty() || info.tokens.size()>prompt.size()) continue;
   232	            if(info.tokens.size()==prompt.size() && !info.logits_resident) continue;
   233	            if(info.tokens.size()<=best_len) continue;
   234	            if(std::equal(info.tokens.begin(),info.tokens.end(),prompt.begin())) {
   235	                best=e.path().string(); best_len=(uint32_t)info.tokens.size();
   236	            }
   237	        }
   238	        if(best.empty()) return false;
   239	        std::filesystem::last_write_time(best,std::filesystem::file_time_type::clock::now(),ec);
   240	        path_out=std::move(best); len_out=best_len;
   241	        return true;
   242	    }
   243	
   244	    std::string path_for(const uint32_t* tokens,uint32_t count) const {
   245	        unsigned char sha[20];
   246	        CC_SHA1(tokens,(CC_LONG)(count*4),sha);
   247	        char hex[41];
   248	        for(int i=0;i<20;i++) snprintf(hex+2*i,3,"%02x",sha[i]);
   249	        return dir_+"/"+tag_+hex+".q27snap";
   250	    }
   251	
   252	    // Budget enforcement: oldest-first until the directory fits. The
   253	    // just-written file is deletable too — the budget is a hard cap, and
   254	    // the gate asserts the total never exceeds it.
   255	    void evict_past_budget() {
   256	        if(!enabled() || !max_bytes_) return;
   257	        std::lock_guard<std::mutex> lk(m_);
   258	        struct F { std::string path; uint64_t size; std::filesystem::file_time_type mtime; };
   259	        std::vector<F> files; uint64_t total=0;
   260	        std::error_code ec;
   261	        for(const auto& e:std::filesystem::directory_iterator(dir_,ec)) {
   262	            if(!e.is_regular_file() || e.path().extension()!=".q27snap") continue;
   263	            const uint64_t sz=(uint64_t)e.file_size(ec);
   264	            files.push_back({e.path().string(),sz,e.last_write_time(ec)});
